# Optional (defaults shown)
# TV_DATABASE_URL=postgresql+psycopg://user:pass@host:5432/trustvault
# TV_COOKIE_SECURE=true
# TV_TRUSTED_PROXIES=0            # number of reverse proxies in front of the app (1 on Render)
# TV_SESSION_IDLE_MINUTES=30
# TV_SESSION_ABSOLUTE_HOURS=8
# TV_MAX_UPLOAD_MB=10
# TV_TRASH_RETENTION_DAYS=30
# TV_DEMO_MODE=false              # protects shared demo accounts/seed documents on a public demo
# TV_SEED_DEMO=false              # create demo data on first start (empty database only)
# TV_AUDIT_CHECKPOINT_EVERY=50
# TV_AUDIT_ANCHOR_FILE=           # optional append-only file for audit-chain anchors
# TV_LOGIN_MAX_FAILURES_PER_USER_IP=5
# TV_LOGIN_MAX_FAILURES_PER_IP=30
# TV_LOGIN_WINDOW_MINUTES=15
